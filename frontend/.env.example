# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
OTP_SECRET=replace-with-a-different-long-random-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.test.account@gmail.com
SMTP_APP_PASSWORD=your_google_app_password
SMTP_FROM="ScholarSathi <your.test.account@gmail.com>"
